{
  "manifest_version": 3,
  "name": "🚀 SuperLevels Privacy Fork",
  "version": "2.1",
  "description": "Privacy-hardened SuperLevels fork with dark mode, cookie editor, redirect tracer, live CSS editor, X/Twitter focus tools, JS toggle, YouTube unhook, JSON formatter, and picture-in-picture.",
  "permissions": ["storage", "cookies", "webRequest", "webNavigation", "contentSettings", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "🚀 SuperLevels Privacy Fork"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
